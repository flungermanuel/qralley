# Copy to .env (never commit .env).
#
# QR_SIGNING_KEYS: JSON map "key version" -> base64url secret (at least 32 random bytes).
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotation: add version 2 here, set qrKeyVersion: 2 in the route, reprint the code.
QR_SIGNING_KEYS={"1":"REPLACE_WITH_RANDOM_BASE64URL_SECRET_OF_AT_LEAST_32_BYTES"}

# PostgreSQL connection (local dev database from infra/docker-compose.yml).
DATABASE_URL=postgres://qurally:qurally_dev@localhost:5433/qurally
